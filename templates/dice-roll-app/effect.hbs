<div>
        <div class="scene-app-might-modifier">
                <div class="npc-subtitle-container-c">
                        <div class="npc-subtitle-text">Effect </div>
                </div>
                <div class="flexrow">
                        <div class="might-scale-entry"><input type="radio" name="effect_scale" class="effect-scale-radio"
                                        value="limited" {{#if (eq effect "limited")}}checked{{/if}}>Limited</div>
                        <div class="might-scale-entry"><input type="radio" name="effect_scale" class="effect-scale-radio"
                                        value="standard" {{#if (eq effect "standard")}}checked{{/if}}>Standard</div>
                        <div class="might-scale-entry"><input type="radio" name="effect_scale" class="effect-scale-radio"
                                        value="great" {{#if (eq effect "great")}}checked{{/if}}>Great</div>
                </div>
        </div>
</div>